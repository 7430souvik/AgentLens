
{
  "name": "AgentLens",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "start": "bun apps/backend/src/server.js"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@souvik080/agentlens-sdk": "^0.1.1",
    "dotenv": "^17.4.2",
    "groq": "^6.11.0",
    "openai": "^7.5.0"
  }
}
